{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "lib": ["ES2022"],
        "types": []
    },
    "include": ["core/**/*.ts"],
    "exclude": ["core/**/*.test.ts"]
}

{
  "name": "obsidian-seek-mcp",
  "version": "1.0.0",
  "description": "MCP server for a Seek index: the bot-side twin of the Obsidian plugin.",
  "private": false,
  "type": "module",
  "bin": {
    "obsidian-seek-mcp": "dist/server.mjs"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "cli": "node dist/cli.mjs",
    "start": "node dist/server.mjs",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "build:bundle": "node build.mjs",
    "prepack": "node build.mjs",
    "dev": "node --experimental-strip-types src/server.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "onnxruntime-common": "1.24.0-dev.20251116-b39e144322",
    "onnxruntime-web": "1.26.0-dev.20260416-b7804b056c",
    "yaml": "^2.9.1"
  },
  "files": [
    "dist",
    "vendor/seek/runtime"
  ],
  "engines": {
    "node": ">=22"
  }
}
